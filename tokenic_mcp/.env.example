# tokenic_mcp configuration
#
#   cp tokenic_mcp/.env.example tokenic_mcp/.env
#   set -a && source tokenic_mcp/.env && set +a
#
# Never commit the filled-in .env — it is gitignored.

# ---------------------------------------------------------------- storage
# memory    zero setup, lost on restart. Default. Right for workshops.
# firestore Firebase. Serverless, matches Cloud Run, no connection pool.
# postgres  Cloud SQL / Supabase / Neon. Choose this if you'll bill from the data.
TOKENIC_BACKEND=memory

# ---------------------------------------------------------------- firestore
# Needs: pip install google-cloud-firestore
#        gcloud firestore databases create --location=us-central1
GOOGLE_CLOUD_PROJECT=your-project-id
# Only if you use a non-default Firestore database:
# FIRESTORE_DATABASE=tokenic

# ---------------------------------------------------------------- postgres
# Needs: pip install "psycopg[binary]" psycopg-pool
#        psql "$DATABASE_URL" -f tokenic_mcp/schema.sql
#
# Local or hosted Postgres:
# DATABASE_URL=postgresql://user:password@localhost:5432/tokenic
#
# Cloud SQL from Cloud Run, over the built-in unix socket. Deploy the service
# with --add-cloudsql-instances PROJECT:REGION:INSTANCE as well:
# DATABASE_URL=postgresql://user:password@/tokenic?host=/cloudsql/PROJECT:REGION:INSTANCE

# ---------------------------------------------------------------- mcp server
# all    both toolsets in one server (default)
# keys   only issue/revoke/list/describe
# usage  only reporting and quota checks
#
# Split them when issuing keys needs tighter access control than reading usage.
TOKENIC_TOOLSET=all

# ---------------------------------------------------------------- quota
# Tokens every new key gets unless issue_api_key is given an explicit quota.
# 2000K = 2,000,000. Set 0 to issue unlimited keys.
TOKENIC_DEFAULT_QUOTA=2000000

# ---------------------------------------------------------------- agent auth
# Off by default so the agent runs open in a workshop. Set to true to require
# an API key on every /chat call: 401 if bad or revoked, 429 if out of quota.
TOKENIC_REQUIRE_KEY=false
