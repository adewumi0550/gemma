# tokenic_mcp configuration — TEMPLATE
#
#   cp tokenic_mcp/.env.example tokenic_mcp/.env
#   python -m tokenic_mcp.check          # verify it works
#
# .env is gitignored. Never commit a filled-in one.

# ---------------------------------------------------------------- storage
# memory     zero setup, lost on restart. Default. Right for workshops.
# firestore  Firebase. Serverless, matches Cloud Run, no connection pool.
# postgres   Cloud SQL / Supabase / Neon. Choose this if you'll bill from the data.
TOKENIC_BACKEND=memory

# ---------------------------------------------------------------- firestore
# Needs: pip install google-cloud-firestore
#        gcloud firestore databases create --location=us-central1
GOOGLE_CLOUD_PROJECT=your-project-id

# Only if you use a non-default Firestore database:
# FIRESTORE_DATABASE=tokenic

# ---------------------------------------------------------------- postgres
# Needs: pip install "psycopg[binary]" psycopg-pool
#
# MCP_DB and DATABASE_URL both work. MCP_DB is preferred here so this service's
# connection string doesn't collide with an application's own DATABASE_URL.
#
# URL-encode special characters in the password — $ becomes %24, @ becomes %40.
# This is the most common cause of a failed connection.
MCP_DB=postgresql://user:password@localhost:5432/tokenic

# Cloud SQL from Cloud Run, over the built-in unix socket. Deploy with
# --add-cloudsql-instances PROJECT:REGION:INSTANCE as well:
# MCP_DB=postgresql://user:password@/tokenic?host=/cloudsql/PROJECT:REGION:INSTANCE

# ---------------------------------------------------------------- mcp server
# all    both toolsets in one server (default)
# keys   only issue/revoke/list/describe
# usage  only reporting and quota checks
#
# Split them when issuing keys needs tighter access control than reading usage.
TOKENIC_TOOLSET=all

# ---------------------------------------------------------------- quota
# Tokens every new key gets unless issue_api_key is given an explicit quota.
# 2000K = 2,000,000. Set 0 to issue unlimited keys.
TOKENIC_DEFAULT_QUOTA=2000000

# ---------------------------------------------------------------- agent auth
# false  agent runs open — no key needed. Right for a workshop.
# true   every /chat call needs a key: 401 if bad or revoked, 429 if out of quota.
TOKENIC_REQUIRE_KEY=false
